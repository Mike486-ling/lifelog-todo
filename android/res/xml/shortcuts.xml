<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_task"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/sc_new"
        android:shortcutLongLabel="@string/sc_new_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.lifelog.app"
            android:targetClass="com.lifelog.app.MainActivity">
            <extra android:name="act" android:value="new" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="stats"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/sc_stats"
        android:shortcutLongLabel="@string/sc_stats_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.lifelog.app"
            android:targetClass="com.lifelog.app.MainActivity">
            <extra android:name="act" android:value="stats" />
        </intent>
    </shortcut>
</shortcuts>
